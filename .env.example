# Copiar a .env.local y llenar con valores reales. Nunca commitear .env* con valores (repo público).

# === LLM: Google Gemini (solo server-side, nunca en el cliente) ===
# El stack se decidió sobre Claude (ADR 0002) pero se cambió a Gemini por
# disponibilidad de key — ver la nota de 2026-07-23 en el ADR.
# Hay DOS modos de auth; con configurar UNO basta. lib/gemini.ts prefiere Vertex.
#
# Modo A — Vertex AI (usa créditos de Google Cloud). Requiere una cuenta de
#   servicio con rol "Vertex AI User". GOOGLE_APPLICATION_CREDENTIALS_JSON es el
#   contenido COMPLETO del JSON de la cuenta de servicio, en una sola línea.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_APPLICATION_CREDENTIALS_JSON=

# Modo B — Gemini API / AI Studio (aistudio.google.com → Get API key).
#   Se usa solo si NO están las credenciales de Vertex de arriba.
GEMINI_API_KEY=

# Supabase — DB de leads, conversaciones y citas (ADR 0003).
# Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=

# Dashboard → Settings → API Keys → Secret keys (empieza con sb_secret_).
# ⚠️  Es la clave SECRETA, no la publicable. NO lleva prefijo NEXT_PUBLIC_
#     a propósito: nunca debe llegar al navegador. Las 3 tablas tienen RLS
#     sin policies, así que la publicable no sirve para nada.
SUPABASE_KEY=
